{
  "input_dir": "data",
  "output_dir": "outputs",
  "save_intermediate": true,
  "run_ablation": true,
  "generate_charts": true,
  "pipeline_1": {
    "description": "Grayscale -> Зашумлення -> Ручний фільтр -> Текстурний аналіз (GLCM/LBP)",
    "noise": {
      "type": "salt_and_pepper",
      "amount": 0.05,
      "sigma": 20.0,
      "seed": 42
    },
    "filter": {
      "filter_type": "median",
      "kernel_size": 3,
      "sigma": 1.0,
      "pad_mode": "edge"
    }
  },
  "pipeline_2": {
    "description": "Grayscale -> Порогова сегментація -> Оператор Собеля",
    "segmentation": {
      "method": "otsu",
      "threshold": 127,
      "invert": false
    },
    "sobel": {
      "edge_threshold": null,
      "pad_mode": "edge"
    }
  }
}
